# MomoPulse — server secrets (copy to .env.local; NEVER commit real values)

# Base58 secret key of the gasless relayer + starter-drip hot wallet.
# Absent ⇒ /api/relay and /api/drip return 503 with a clear reason; claims fall back to
# the direct path (user pays their own ~0.000005 COOK fee).
# Fund it with 1 COOK ≈ 2,000,000 sponsored transactions at Cookie Chain fees.
RELAYER_SECRET=

# Cloudflare Turnstile (humanity check for relay + drip). Absent ⇒ explicit dev-bypass
# (responses carry dev:true); per-wallet/per-IP limits still enforced.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Disclosed referral: 20% of the 1% trade fee on every buy from this terminal.
NEXT_PUBLIC_COOKIE_REFERRER=

# cookie-mcp external-signer agent path (requires Node ≥22). Off ⇒ direct-build only.
MCP_ENABLED=false
